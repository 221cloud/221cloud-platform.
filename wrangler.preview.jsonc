{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "221cloud-auth-preview",
  "main": "src/index.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/site/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "221cloud-preview",
      "database_id": "e3de504d-3f1c-4869-8b78-deee4fd96bc4"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}